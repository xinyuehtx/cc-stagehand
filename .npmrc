# Hoist transitive deps (e.g. tslib, required by @aws-crypto/* via the AWS SDK
# pulled in by @browserbasehq/stagehand) to the root node_modules so Node can
# resolve them under pnpm's strict layout. Without this, CI (fresh
# `pnpm install --frozen-lockfile`) fails with "Cannot find module 'tslib'".
shamefully-hoist=true
